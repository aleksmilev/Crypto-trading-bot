:80 {
	encode zstd gzip

	@allowedClient remote_ip {$ALLOWED_CLIENT_IPS:127.0.0.1}

	handle /api/* {
		@notAllowedClient not remote_ip {$ALLOWED_CLIENT_IPS:127.0.0.1}
		respond @notAllowedClient "Forbidden" 403
		reverse_proxy gateway:3000
	}

	handle {
		respond @notAllowedClient "Forbidden" 403
		reverse_proxy {$FRONTEND_UPSTREAM:frontend:80}
	}
}
