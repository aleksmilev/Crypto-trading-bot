{
  "name": "@trading/db",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./dist/schema/index.js",
    "./migrate": "./dist/migrate.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/migrations dist/migrations",
