# =========================================================
# APPLICATION
# =========================================================

NODE_ENV=development

APP_NAME=AI Trading Bot

API_PORT=3000

LOG_LEVEL=info

# Enables /api/test/* smoke-test endpoints. Disable once real pipelines exist.
ENABLE_TEST_ROUTES=true


# =========================================================
# PUBLISHED PORTS (Caddy)
# =========================================================

HTTP_PORT=80

HTTPS_PORT=443


# =========================================================
# POSTGRES
# =========================================================

# Used to build DATABASE_URL in compose.yml. Keep it URL-safe (letters/digits).
# Only applied when the postgres_data volume is first created.
POSTGRES_PASSWORD=change-me

# Only needed when running backend processes outside Docker (e.g. LXC or `npm run dev`).
# Inside Docker Compose this value is overridden.
# DATABASE_URL=postgres://trading:change-me@127.0.0.1:5432/trading


# =========================================================
# REDIS
# =========================================================

REDIS_URL=redis://redis:6379


# =========================================================
# AI
# =========================================================

AI_PROVIDER=openai

AI_API_KEY=replace-me

AI_MODEL=replace-me


# =========================================================
# MARKET DATA
# =========================================================

MARKET_PROVIDER=replace-me

MARKET_API_KEY=replace-me

MARKET_API_SECRET=replace-me


# =========================================================
# SCHEDULING
# =========================================================

MARKET_INTERVAL_MINUTES=15

# Five AI decision runs per day.
AI_DECISION_CRON=0 1,6,11,16,21 * * *

SCHEDULER_TIMEZONE=UTC


# =========================================================
# TRADING MODE
# =========================================================

# shadow | paper | live. Live additionally requires the
# live_trading_enabled database setting to be true.
TRADING_ENABLED=false

TRADING_MODE=shadow


# =========================================================
# GRAFANA
# =========================================================

GRAFANA_PASSWORD=change-me
